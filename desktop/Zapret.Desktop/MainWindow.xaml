<Window x:Class="Zapret.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-zapret" Width="1280" Height="900" MinWidth="1040" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,28,20,20">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,38">
          <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}"><TextBlock Text="Z" FontWeight="Bold" FontSize="29" Foreground="#0C3027" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Z-zapret" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="СВОБОДА СОЕДИНЕНИЯ" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="1,4,0,0" /></StackPanel></StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0"><Border Background="#19362F" CornerRadius="7" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="WINDOWS 10 / 11 · x64" FontSize="10" Foreground="#7CE8BF" /></Border><TextBlock Text="Версия 0.1.0" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" /><TextBlock Text="Движок zapret · профили Flowseal" FontSize="10" Style="{StaticResource Muted}" /></StackPanel>
        <StackPanel>
          <Button Content="◉    Обзор" Style="{StaticResource Nav}" Tag="Home" Click="Navigate_Click" />
          <Button Content="↗    Автоподбор" Style="{StaticResource Nav}" Tag="Tests" Click="Navigate_Click" />
          <Button Content="≡    Стратегии" Style="{StaticResource Nav}" Tag="Strategies" Click="Navigate_Click" />
          <Button Content="◇    Диагностика" Style="{StaticResource Nav}" Tag="Diagnostics" Click="Navigate_Click" />
          <Button Content="⚙    Настройки" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate_Click" />
          <Button Content="▤    Журнал" Style="{StaticResource Nav}" Tag="Logs" Click="Navigate_Click" />
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="10,22" />
          <Button Content="↗    GitHub проекта" Style="{StaticResource Nav}" Click="GitHub_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="36,28,36,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="30" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitle" Text="Ваше подключение. Ваши правила." Style="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel><Button Content="Сменить тему" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Theme_Click" Padding="14,9" /></Grid>
      <Border x:Name="ErrorBanner" Grid.Row="1" Background="#51252C" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFD4D8" /></Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <Grid>
          <StackPanel x:Name="HomePanel">
            <Border Style="{StaticResource Card}" Padding="30"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="СОСТОЯНИЕ ПОДКЛЮЧЕНИЯ" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Margin="0,18,0,10"><Ellipse x:Name="StateDot" Width="12" Height="12" Fill="#7B8DA6" Margin="0,0,12,0" /><TextBlock x:Name="ConnectionTitle" Text="Готов к запуску" FontSize="29" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Выберите стратегию или запустите автоподбор." Style="{StaticResource Muted}" /><TextBlock x:Name="ActiveStrategyText" Text="Активная стратегия: —" Margin="0,22,0,0" FontSize="13" /></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><Button x:Name="ConnectButton" Content="Включить" Style="{StaticResource Primary}" FontSize="17" Padding="26,20" Click="Connect_Click" /><TextBlock Text="Для работы нужен доступ администратора" FontSize="11" TextAlignment="Center" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel>
            </Grid></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Найдём подходящий профиль" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Приложение проверит соединение и сравнит стратегии на вашей сети." Style="{StaticResource Muted}" Margin="0,10,0,20" /><Button Content="Запустить автоподбор  →" Tag="Tests" HorizontalAlignment="Left" Click="Navigate_Click" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Запуск вместе с Windows" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ServiceText" Text="Движок запускается вручную. Автозапуск можно включить одной кнопкой." Style="{StaticResource Muted}" Margin="0,10,0,20" /><Button x:Name="ServiceButton" Content="Включить автозапуск" HorizontalAlignment="Left" Click="Service_Click" /></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Текущая стратегия" Style="{StaticResource Heading}" /><ComboBox x:Name="HomeStrategyPicker" SelectionChanged="HomeStrategy_Changed" /><TextBlock x:Name="StrategyDescription" Style="{StaticResource Muted}" Margin="0,10,0,0" /><TextBlock Text="Состояние движка и доступность сервисов проверяются отдельно. Доступный сайт не гарантирует работу видео, QUIC или голосового чата." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="TestsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Подбор под вашу сеть" Style="{StaticResource Heading}" /><TextBlock Text="Сначала проверим соединение без обхода, затем сравним профили. Лучшие результаты проверим повторно." Style="{StaticResource Muted}" /><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="TestModePicker" SelectedIndex="0"><ComboBoxItem Content="Быстрый · 5 профилей" /><ComboBoxItem Content="Полный · все 22 профиля" /><ComboBoxItem Content="DPI · передача данных" /></ComboBox><Button x:Name="StartTestsButton" Grid.Column="2" Content="Начать проверку" Style="{StaticResource Primary}" Click="StartTests_Click" /><Button x:Name="CancelTestsButton" Grid.Column="4" Content="Отмена" IsEnabled="False" Click="CancelTests_Click" /></Grid><CheckBox x:Name="OnlySelectedCheck" Content="Проверить только выбранную стратегию" /><TextBlock Text="Во время перебора подключение может прерываться. Результат относится к текущей сети. Голосовой Discord и воспроизведение видео этими запросами не проверяются." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="RecommendationTitle" Text="Результаты появятся здесь" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="RecommendationDetail" Text="Запустите проверку, чтобы сравнить стратегии." Style="{StaticResource Muted}" Margin="0,9,0,16" /><StackPanel Orientation="Horizontal"><Button x:Name="ApplyRecommendedButton" Content="Применить рекомендацию" IsEnabled="False" Click="ApplyRecommended_Click" Style="{StaticResource Primary}" Margin="0,0,12,0" /><Button x:Name="ExportTestsButton" Content="Сохранить отчёт" IsEnabled="False" Click="ExportTests_Click" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="Проверки соединения" FontSize="18" FontWeight="SemiBold" Margin="8,4,0,12" /><DataGrid x:Name="ProbeGrid" Height="320"><DataGrid.Columns><DataGridTextColumn Header="Стратегия" Binding="{Binding Strategy}" Width="1.15*" /><DataGridTextColumn Header="Ресурс" Binding="{Binding Target}" Width="1.2*" /><DataGridTextColumn Header="Проверка" Binding="{Binding Protocol}" Width="90" /><DataGridTextColumn Header="Результат" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="мс" Binding="{Binding Latency}" Width="70" /></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle></DataGrid></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="StrategiesPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Все профили Flowseal" Style="{StaticResource Heading}" /><TextBlock Text="Сохранены все 22 исходные стратегии. Выбор профиля применяется при следующем запуске движка." Style="{StaticResource Muted}" /><DataGrid x:Name="StrategiesGrid" Height="440" Margin="0,18,0,18"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.1*" /><DataGridTextColumn Header="Исходный файл" Binding="{Binding Source}" Width="1.3*" /><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="1.7*" /></DataGrid.Columns></DataGrid><Button x:Name="ChooseStrategyButton" Content="Выбрать стратегию" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="ChooseStrategy_Click" /></StackPanel></Border></StackPanel>
          <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Проверка окружения" Style="{StaticResource Heading}" /><TextBlock Text="Покажем состояние компонентов и возможные конфликты. Исправления запускаются отдельными действиями." Style="{StaticResource Muted}" /><WrapPanel Margin="0,18,0,18"><Button x:Name="DiagnoseButton" Content="Проверить систему" Style="{StaticResource Primary}" Click="Diagnose_Click" Margin="0,0,10,10" /><Button x:Name="ClearCacheButton" Content="Очистить кэш Discord" Click="ClearCache_Click" Margin="0,0,10,10" /><Button x:Name="TimestampsButton" Content="Включить TCP timestamps" Click="Timestamps_Click" Margin="0,0,10,10" /><Button Content="Открыть службы Windows" Click="OpenServices_Click" Margin="0,0,0,10" /></WrapPanel><DataGrid x:Name="DiagnosticsGrid" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="150" /><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="Описание" Binding="{Binding Detail}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border><Button x:Name="LegacyButton" Content="Открыть консольные инструменты Flowseal" Click="Legacy_Click" HorizontalAlignment="Left" /><TextBlock Text="Для работы консольных инструментов сначала остановите движок приложения." Style="{StaticResource Muted}" FontSize="12" Margin="0,10" /></StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Фильтрация трафика" Style="{StaticResource Heading}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IPSet" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox x:Name="IpSetPicker" SelectedIndex="0"><ComboBoxItem Content="Выключен · none" /><ComboBoxItem Content="Адреса из списка · loaded" /><ComboBoxItem Content="Любой адрес · any" /></ComboBox><TextBlock Text="TCP-порты игрового фильтра" Style="{StaticResource Muted}" Margin="0,16,0,6" /><TextBox x:Name="TcpPortsBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Игровой фильтр" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox x:Name="GameFilterPicker" SelectedIndex="0"><ComboBoxItem Content="Выключен" /><ComboBoxItem Content="TCP и UDP" /><ComboBoxItem Content="Только TCP" /><ComboBoxItem Content="Только UDP" /></ComboBox><TextBlock Text="UDP-порты игрового фильтра" Style="{StaticResource Muted}" Margin="0,16,0,6" /><TextBox x:Name="UdpPortsBox" /></StackPanel></Grid><TextBlock Text="Режим any затрагивает больше соединений. Используйте его при необходимости и проверяйте обычные сайты после изменения настроек." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" /><CheckBox x:Name="TrayCheck" Content="Сворачивать приложение в трей при закрытии окна" /><TextBlock Text="Фейк для Discord UDP" Style="{StaticResource Muted}" Margin="0,14,0,6" /><ComboBox x:Name="DiscordFakePicker" /><TextBlock Text="Фейк для игрового UDP" Style="{StaticResource Muted}" Margin="0,14,0,6" /><ComboBox x:Name="GameFakePicker" /><Button x:Name="SaveSettingsButton" Content="Сохранить и применить" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Свои адреса и исключения" Style="{StaticResource Heading}" /><ComboBox x:Name="UserListPicker" SelectedIndex="0" SelectionChanged="UserList_Changed"><ComboBoxItem Content="Домены для обхода" /><ComboBoxItem Content="Исключённые домены" /><ComboBoxItem Content="Исключённые IP и подсети" /><ComboBoxItem Content="Свои IP и подсети · для режима loaded" /></ComboBox><TextBox x:Name="UserListBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="150" FontFamily="Consolas" Margin="0,12" /><Button x:Name="SaveListButton" Content="Сохранить список" HorizontalAlignment="Left" Click="SaveList_Click" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Обновления и обслуживание" Style="{StaticResource Heading}" /><WrapPanel><Button x:Name="UpdateIpSetButton" Content="Обновить IPSet" Click="UpdateIpSet_Click" Margin="0,0,10,10" /><Button x:Name="UpdateHostsButton" Content="Обновить hosts" Click="UpdateHosts_Click" Margin="0,0,10,10" /><Button x:Name="RemoveHostsButton" Content="Убрать записи Z-zapret из hosts" Click="RemoveHosts_Click" Margin="0,0,10,10" /><Button x:Name="CheckUpdatesButton" Content="Проверить обновления приложения" Click="CheckUpdates_Click" Margin="0,0,10,10" /><Button Content="Открыть страницу релизов" Click="Releases_Click" Margin="0,0,10,10" /></WrapPanel><TextBlock Text="Обновления движка устанавливаются с новой сборкой приложения. Пользовательские списки хранятся отдельно." Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="LogsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="События приложения" Style="{StaticResource Heading}" /><Button Content="Сохранить журнал" HorizontalAlignment="Right" Click="ExportLog_Click" Padding="14,8" /></Grid><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="490" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Margin="0,12,0,0" /></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><StackPanel><Grid><TextBlock x:Name="StatusText" Text="Подготовка приложения…" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="ProgressCounter" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" /></Grid><ProgressBar x:Name="OperationProgress" Margin="0,10,0,0" Visibility="Collapsed" /></StackPanel></Border>
    </Grid>
  </Grid>
</Window>
