<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>x2zapret</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Zapret.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zapret.Core\Zapret.Core.csproj" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Runtime\PcInfo\Collect.ps1" />
    <Resource Include="Assets\x2air.png" />
    <Content Include="..\..\resources\catalogs\strategies.json" CopyToOutputDirectory="PreserveNewest" Link="strategies.json" />
    <Content Include="..\..\resources\catalogs\upstream-info.json" CopyToOutputDirectory="PreserveNewest" Link="upstream-info.json" />
    <Content Include="..\..\resources\catalogs\legacy-seed-hashes.json" CopyToOutputDirectory="PreserveNewest" Link="legacy-seed-hashes.json" />
    <Content Include="..\..\resources\catalogs\targets.json" CopyToOutputDirectory="PreserveNewest" Link="targets.json" />
  </ItemGroup>
</Project>
