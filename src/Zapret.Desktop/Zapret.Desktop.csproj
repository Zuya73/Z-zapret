<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>x2zapret</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Zapret.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <ProjectReference Include="..\Zapret.Core\Zapret.Core.csproj" />
    <EmbeddedResource Include="..\..\vendor\hardware\licenses\*.txt"><LogicalName>Zapret.Desktop.Hardware.Licenses.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\diskspd\bin\diskspd.exe" LogicalName="Zapret.Desktop.DiskBench.diskspd.exe" />
    <EmbeddedResource Include="..\..\vendor\diskspd\manifest.json" LogicalName="Zapret.Desktop.DiskBench.manifest.json" />
    <EmbeddedResource Include="..\..\vendor\diskspd\LICENSE.txt" LogicalName="Zapret.Desktop.DiskBench.LICENSE.txt" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Runtime\PcInfo\Collect.ps1" />
    <EmbeddedResource Include="Assets\Hardware\components.json" LogicalName="Zapret.Desktop.Hardware.components.json" />
    <Resource Include="Assets\x2air.png" />
    <Content Include="..\..\resources\catalogs\strategies.json" CopyToOutputDirectory="PreserveNewest" Link="strategies.json" />
    <Content Include="..\..\resources\catalogs\upstream-info.json" CopyToOutputDirectory="PreserveNewest" Link="upstream-info.json" />
    <Content Include="..\..\resources\catalogs\legacy-seed-hashes.json" CopyToOutputDirectory="PreserveNewest" Link="legacy-seed-hashes.json" />
    <Content Include="..\..\resources\catalogs\targets.json" CopyToOutputDirectory="PreserveNewest" Link="targets.json" />
  </ItemGroup>
</Project>
