<Window x:Class="Zapret.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:ui="clr-namespace:Zapret.Desktop.Runtime"
        Title="x2zapret" Style="{StaticResource {x:Type Window}}" Width="1280" Height="900" MinWidth="1040" MinHeight="760" WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Background="{DynamicResource SidebarBrush}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Image Source="{DynamicResource BrandMark}" Height="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Width="1" Height="12" Background="{DynamicResource LineStrongBrush}" Margin="10,0" />
        <TextBlock Text="x2zapret" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="&#xE921;" Style="{StaticResource WindowButton}" AutomationProperties.Name="Свернуть" ToolTip="Свернуть" Click="Minimize_Click" />
        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButton}" AutomationProperties.Name="Развернуть или восстановить" ToolTip="Развернуть" Click="Maximize_Click" />
        <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" AutomationProperties.Name="Закрыть" ToolTip="Закрыть" Click="Close_Click" />
      </StackPanel>
    </Grid>
  <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="248" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,18,16,18">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,26">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource BrandMark}" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <Border Width="1" Height="26" Background="{DynamicResource LineStrongBrush}" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock Text="zapret" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,0,3" />
          </StackPanel>
          <TextBlock Text="X2AIR  ·  CONNECTION UTILITY" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{DynamicResource SubtleBrush}" Margin="1,12,0,0" />
        </StackPanel>
        <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="8,16,8,0">
          <Border Style="{StaticResource Divider}" Margin="0,0,0,16" />
          <Grid>
            <TextBlock x:Name="AppVersionText" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="7,3"><TextBlock Text="WIN 10 / 11 · x64" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{DynamicResource MutedBrush}" /></Border>
          </Grid>
          <TextBlock x:Name="AuthorText" Text="by Zuya" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,4" />
          <TextBlock Text="На основе zapret и профилей Flowseal" FontSize="10" Style="{StaticResource Muted}" LineHeight="15" Foreground="{DynamicResource SubtleBrush}" />
        </StackPanel>
        <ScrollViewer ui:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
          <Border x:Name="NavigationMarker" Height="40" CornerRadius="10" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="-1,0,0,0" />
          </Border>
          <StackPanel x:Name="NavigationPanel">
            <Button Style="{StaticResource Nav}" Tag="Home" Click="Navigate_Click" AutomationProperties.Name="Обзор"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="Обзор" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource Nav}" Tag="Tests" Click="Navigate_Click" AutomationProperties.Name="Автоподбор"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="Автоподбор" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource Nav}" Tag="Strategies" Click="Navigate_Click" AutomationProperties.Name="Профили"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="Профили" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource Nav}" Tag="Diagnostics" Click="Navigate_Click" AutomationProperties.Name="Диагностика"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="Диагностика" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource Nav}" Tag="Tools" Click="Navigate_Click" AutomationProperties.Name="X2 Tools"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="X2 Tools" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource Nav}" Tag="Settings" Click="Navigate_Click" AutomationProperties.Name="Настройки"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="Настройки" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource Nav}" Tag="Logs" Click="Navigate_Click" AutomationProperties.Name="Журнал"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="Журнал" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Style="{StaticResource Divider}" Margin="12,18" />
            <Button Style="{StaticResource Nav}" Click="GitHub_Click" AutomationProperties.Name="GitHub проекта"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" Width="30" /><TextBlock Text="GitHub проекта" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
        </Grid></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="40,30,40,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="PageHeading" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="Обзор" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitle" Text="Включите обход и проверьте доступ к сайтам." Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
        <Border x:Name="HeaderStatus" Grid.Column="1" VerticalAlignment="Top" Margin="16,6,0,0" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="12,7,14,7" Background="{DynamicResource PanelBrush}">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock x:Name="HeaderStatusText" Text="ПОДГОТОВКА" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></StackPanel>
        </Border>
      </Grid>
      <Border x:Name="ErrorBanner" Grid.Row="1" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,8,12" Margin="0,0,0,16" Visibility="Collapsed">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,0,14,0"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" /></Border>
          <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" FontWeight="Normal" Style="{StaticResource Ghost}" Padding="10" VerticalAlignment="Top" Margin="8,-4,0,0" Foreground="{DynamicResource MutedBrush}" ToolTip="Скрыть сообщение" AutomationProperties.Name="Скрыть сообщение об ошибке" Click="DismissError_Click" />
        </Grid>
      </Border>
      <Border Grid.Row="2" ClipToBounds="True"><ScrollViewer x:Name="PageScroll" ui:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <Grid>
          <StackPanel x:Name="HomePanel">
            <Border x:Name="HeroCard" Background="{DynamicResource HeroBrush}" CornerRadius="20" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" Margin="0,0,0,16" ui:Motion.Kind="Card">
              
              <Grid MinHeight="250">
                <Rectangle Fill="{DynamicResource GrainBrush}" RadiusX="20" RadiusY="20" IsHitTestVisible="False" />
                <Image Source="{DynamicResource BrandEmblem}" Width="300" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,250,12" Opacity="0.10" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                <Grid Margin="32,30,32,30"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="236" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="СОСТОЯНИЕ ПОДКЛЮЧЕНИЯ" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                      <Grid Width="14" Height="14" Margin="0,4,14,0" VerticalAlignment="Center">
                        <Ellipse x:Name="StatePulse" Fill="{DynamicResource AccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform></Ellipse>
                        <Ellipse x:Name="StateDot" Fill="{DynamicResource SubtleBrush}" />
                      </Grid>
                      <TextBlock x:Name="ConnectionTitle" Text="Обход отключён" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionDetail" Text="Выберите профиль или запустите автоподбор." Style="{StaticResource Muted}" />
                    <Border HorizontalAlignment="Left" Margin="0,20,0,0" Background="{DynamicResource ChipFillBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,0" /><TextBlock x:Name="ActiveStrategyText" Text="Текущий профиль: —" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" /></StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button x:Name="ConnectButton" Content="Включить обход" Style="{StaticResource Primary}" FontSize="16" Padding="24,19" Click="Connect_Click" />
                    <TextBlock Text="Если Windows запросит разрешение, нажмите «Да»." FontSize="11" TextAlignment="Center" Style="{StaticResource Muted}" LineHeight="17" Margin="6,12,6,0" />
                    <Button x:Name="HomeCheckButton" Margin="0,14,0,0" Padding="14,10" FontSize="12" Click="CheckHome_Click" ToolTip="Проверить, отвечают ли сайты и серверы Discord и YouTube прямо сейчас" AutomationProperties.Name="Проверить Discord и YouTube"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock x:Name="HomeCheckText" Text="Проверить Discord и YouTube" VerticalAlignment="Center" /></StackPanel></Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><DockPanel>
                <Border DockPanel.Dock="Top" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /></Border>
                <TextBlock DockPanel.Dock="Top" Text="Найдём подходящий профиль" FontSize="17" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Bottom" Content="Запустить автоподбор  →" Tag="Tests" HorizontalAlignment="Left" Click="Navigate_Click" />
                <TextBlock Text="Программа проверит готовые профили и предложит подходящий для вашей сети." Style="{StaticResource Muted}" Margin="0,8,0,20" />
              </DockPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel>
                <Border DockPanel.Dock="Top" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="&#xE9F5;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /></Border>
                <TextBlock DockPanel.Dock="Top" Text="Фоновое подключение" FontSize="17" FontWeight="SemiBold" />
                <Button x:Name="ServiceButton" DockPanel.Dock="Bottom" Content="Включить фоновое подключение" HorizontalAlignment="Left" Click="Service_Click" />
                <TextBlock x:Name="ServiceText" Text="Включите эту настройку, чтобы обход работал после полного выхода из программы." Style="{StaticResource Muted}" Margin="0,8,0,20" />
              </DockPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Профиль подключения" Style="{StaticResource Heading}" /><ComboBox x:Name="HomeStrategyPicker" SelectionChanged="HomeStrategy_Changed" AutomationProperties.Name="Профиль подключения" /><TextBlock x:Name="StrategyDescription" Style="{StaticResource Muted}" Margin="0,12,0,0" /><Border Style="{StaticResource Divider}" Margin="0,18,0,14" /><TextBlock Text="Включённый обход ещё не означает, что сайты доступны. Программа проверяет их отдельно; просмотр видео и голосовой чат проверяйте в самих сервисах." Style="{StaticResource Muted}" Foreground="{DynamicResource SubtleBrush}" FontSize="12" LineHeight="19" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="TestsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Подбор профиля подключения" Style="{StaticResource Heading}" /><TextBlock Text="Сначала проверим интернет без обхода, затем попробуем разные профили. Лучшие варианты проверим ещё раз." Style="{StaticResource Muted}" /><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="TestModePicker" ToolTip="Быстрый режим проверит несколько профилей. Полный — все профили. Режим DPI дополнительно проверит передачу тестовых данных." SelectedIndex="0"><ComboBoxItem Content="Быстрый · 5 профилей" /><ComboBoxItem x:Name="FullTestModeItem" Content="Полный · все профили" /><ComboBoxItem Content="Передача данных · DPI" /></ComboBox><Button x:Name="StartTestsButton" Grid.Column="2" Content="Начать проверку" Style="{StaticResource Primary}" Click="StartTests_Click" /><Button x:Name="CancelTestsButton" Grid.Column="4" Content="Отмена" IsEnabled="False" Click="CancelTests_Click" /></Grid><CheckBox x:Name="OnlySelectedCheck" Content="Проверить только выбранный профиль" /><TextBlock Text="Во время подбора интернет может ненадолго прерываться. Результат подходит для сети, к которой вы подключены сейчас. Видео и голосовой чат проверяйте отдельно." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="RecommendationTitle" Text="Результаты появятся здесь" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="RecommendationDetail" Text="Нажмите «Начать проверку», чтобы подобрать профиль." Style="{StaticResource Muted}" Margin="0,9,0,16" /><StackPanel x:Name="AdviceBox" Visibility="Collapsed" Margin="0,0,0,16"><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14"><StackPanel><TextBlock Text="ЧТО МОЖНО СДЕЛАТЬ" Style="{StaticResource Caption}" Margin="0,0,0,8" /><TextBlock x:Name="AdviceText" TextWrapping="Wrap" LineHeight="22" /><WrapPanel Margin="0,12,0,0"><Button Content="DNS и сброс сети" Click="OpenNetworkTools_Click" Margin="0,0,8,0" FontSize="12" Padding="14,8" /><Button Content="Открыть «Диагностику»" Tag="Diagnostics" Click="Navigate_Click" FontSize="12" Padding="14,8" /></WrapPanel></StackPanel></Border></StackPanel><StackPanel Orientation="Horizontal"><Button x:Name="ApplyRecommendedButton" Content="Включить рекомендованный профиль" IsEnabled="False" Click="ApplyRecommended_Click" Style="{StaticResource Primary}" Margin="0,0,12,0" /><Button x:Name="ExportTestsButton" Content="Сохранить отчёт" IsEnabled="False" Click="ExportTests_Click" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="Проверки соединения" FontSize="18" FontWeight="SemiBold" Margin="8,4,0,12" /><DataGrid x:Name="ProbeGrid" Height="320"><DataGrid.Columns><DataGridTextColumn Header="Профиль" Binding="{Binding Strategy}" Width="1.15*" /><DataGridTextColumn Header="Сервис / сервер" Binding="{Binding Target}" Width="1.2*" /><DataGridTextColumn Header="Проверка" Binding="{Binding Protocol}" Width="90" /><DataGridTextColumn Header="Результат" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="мс" Binding="{Binding Latency}" Width="70" /></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle></DataGrid></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="StrategiesPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Готовые профили подключения" Style="{StaticResource Heading}" /><TextBlock Text="Здесь собраны профили Flowseal из этой версии программы. Выбранный профиль начнёт работать после следующего включения обхода." Style="{StaticResource Muted}" /><DataGrid x:Name="StrategiesGrid" RowHeight="NaN" MinRowHeight="40" Height="440" Margin="0,18,0,18"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.1*" /><DataGridTextColumn Header="Исходный файл" Binding="{Binding Source}" Width="1.3*" /><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="1.7*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6" /><Setter Property="ToolTip" Value="{Binding Description}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><Button x:Name="ChooseStrategyButton" Content="Выбрать профиль" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="ChooseStrategy_Click" /></StackPanel></Border></StackPanel>
          <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Проверка программы и Windows" Style="{StaticResource Heading}" /><TextBlock Text="Проверим необходимые файлы и службы Windows. Если обнаружится проблема, ниже появится объяснение. Изменения запускаются отдельными кнопками." Style="{StaticResource Muted}" /><WrapPanel Margin="0,18,0,18"><Button x:Name="DiagnoseButton" Content="Проверить систему" Style="{StaticResource Primary}" Click="Diagnose_Click" Margin="0,0,10,10" /><Button x:Name="ClearCacheButton" Content="Очистить кэш Discord" Click="ClearCache_Click" Margin="0,0,10,10" /><Button x:Name="TimestampsButton" Content="Включить TCP timestamps" Click="Timestamps_Click" Margin="0,0,10,10" /><Button Content="Открыть службы Windows" Click="OpenServices_Click" Margin="0,0,0,10" /></WrapPanel><DataGrid x:Name="DiagnosticsGrid" RowHeight="NaN" MinRowHeight="40" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="150" /><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="Описание" Binding="{Binding Detail}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6" /><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Доступность сервисов" Style="{StaticResource Heading}" />
              <TextBlock Text="Проверяем, отвечают ли сайты и серверы Discord и YouTube. Это не проверка воспроизведения видео или голосового чата." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
              <Button Content="Проверить доступность сейчас" Click="CheckConnection_Click" HorizontalAlignment="Left" Margin="0,0,0,12" />
              <DataGrid x:Name="HealthChecksGrid" RowHeight="NaN" MinRowHeight="40" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Сервис" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*" /><DataGridTextColumn Header="Ответ" Binding="{Binding Latency}" Width="85" /><DataGridTextColumn Header="Подробности" Binding="{Binding Detail}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6" /><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
            </StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="Оформление" Style="{StaticResource Heading}" Margin="0,0,0,6" /><TextBlock Text="Тёмная или светлая тема. «Как в Windows» переключается вместе с настройкой Windows." Style="{StaticResource Muted}" FontSize="12" LineHeight="19" /></StackPanel>
              <ComboBox x:Name="ThemePicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ThemePicker_Changed" AutomationProperties.Name="Оформление программы"><ComboBoxItem Content="Тёмная" Tag="Dark" /><ComboBoxItem Content="Светлая" Tag="Light" /><ComboBoxItem Content="Как в Windows" Tag="System" /></ComboBox>
            </Grid></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Контроль подключения" Style="{StaticResource Heading}" />
              <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="Проверять доступность сервисов" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Проверять Discord, YouTube и другие сайты каждые 45 секунд. Работает, пока программа открыта или свёрнута к значку рядом с часами." Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
                <CheckBox x:Name="MonitorConnectionSwitch" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="Проверять доступность сервисов" />
              </Grid>
              <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="Умное переподключение" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Если доступ пропал, попробовать восстановить его и подобрать другой профиль. После ручного отключения обход не включится сам. При отсутствии интернета профили не перебираются." Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
                <CheckBox x:Name="AutoReconnectSwitch" ToolTip="Восстановление начинается после трёх неудачных проверок за период не короче 75 секунд, если контрольный сайт отвечает. До 3 попыток за 15 минут; пауза между ними — от 2 минут." Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="Умное переподключение" />
              </Grid>
