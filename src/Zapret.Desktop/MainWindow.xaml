                <TextBlock x:Name="SpeedLatencyText" Text="Задержка без нагрузки и во время передачи данных" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" />
                <WrapPanel><ComboBox x:Name="SpeedModePicker" SelectedIndex="0" MinWidth="230" Margin="0,0,10,8"><ComboBoxItem Content="Быстрый · до 62 МБ" /><ComboBoxItem Content="Подробный · до 262 МБ" /></ComboBox><Button x:Name="SpeedStartButton" Content="Измерить скорость" Click="StartSpeed_Click" Style="{StaticResource Primary}" Margin="0,0,8,8" /><Button x:Name="SpeedCancelButton" Content="Отменить" Click="CancelExtended_Click" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Измеряем скорость скачивания и отправки данных до сервера Cloudflare. Перед запуском приостановите другие загрузки. Тест расходует до 62 или 262 МБ данных плюс небольшой служебный трафик. На другом сервере скорость может отличаться." Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock x:Name="NetworkStageText" Text="Запустите нужную проверку." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" /><WrapPanel><Button x:Name="SaveNetworkButton" Content="Сохранить отчёт" Click="SaveNetwork_Click" IsEnabled="False" /></WrapPanel></StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="SpaceToolPanel" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
                <TextBlock Text="Что занимает место" Style="{StaticResource Heading}" />
                <TextBox x:Name="SpacePathBox" MaxLength="32767" AutomationProperties.Name="Папка для анализа занятого места" Margin="0,0,0,10" />
                <WrapPanel Margin="0,0,0,10"><Button x:Name="SpaceStartButton" Content="Анализировать" Style="{StaticResource Primary}" Click="StartSpace_Click" Margin="0,0,8,8" /><Button x:Name="SpaceBrowseButton" Content="Выбрать папку" Click="BrowseSpace_Click" Margin="0,0,8,8" /><Button x:Name="SpaceParentButton" Content="На уровень выше" Click="ParentSpace_Click" Margin="0,0,8,8" /><Button x:Name="SpaceCancelButton" Content="Отменить" Click="CancelExtended_Click" Margin="0,0,0,8" IsEnabled="False" /></WrapPanel>
                <TextBlock x:Name="SpaceStatusText" Text="Выберите накопитель или папку." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
                <TextBlock Text="ПАПКИ · откройте двойным щелчком" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                <DataGrid x:Name="SpaceFolderGrid" SelectionChanged="SpaceSelection_Changed" Height="240" FontSize="11" MouseDoubleClick="SpaceFolder_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Папка" Binding="{Binding Path}" Width="2*" /><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100" /><DataGridTemplateColumn Header="Доля" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="4,8"><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="18" Opacity="0.3" /><TextBlock Text="{Binding Share}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                <Button x:Name="SpaceOpenButton" Content="Показать выбранное в проводнике" Click="OpenSpace_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="100 крупнейших файлов" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" /><DataGrid x:Name="SpaceFilesGrid" SelectionChanged="SpaceSelection_Changed" Height="240" FontSize="11"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="110" /></DataGrid.Columns></DataGrid><Button Content="Показать файл в проводнике" Click="OpenSpace_Click" HorizontalAlignment="Left" Margin="0,12,0,0" /><TextBlock Text="Показываем размеры доступных файлов, поэтому сумма может отличаться от занятого места в свойствах диска. Недоступные папки и ссылки пропускаются. Поиск длится до 10 минут; при отмене найденные результаты остаются. Файлы не изменяются." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" /></StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="ShutdownToolPanel" Visibility="Collapsed"><StackPanel.Resources><Style x:Key="TimerMuted" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="LineHeight" Value="18" /></Style></StackPanel.Resources>
            <Border Style="{StaticResource Card}" Padding="18">
              <StackPanel>
                <TextBlock Text="ВЫКЛЮЧЕНИЕ КОМПЬЮТЕРА" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Выключение по таймеру" Style="{StaticResource Heading}" />
                <TextBlock Text="Выберите, через сколько выключить компьютер. Таймер продолжит работать, даже если закрыть x2zapret." Style="{StaticResource TimerMuted}" Margin="0,0,0,12" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="24" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Часы" Style="{StaticResource TimerMuted}" Margin="0,0,0,7" /><TextBox x:Name="ShutdownHoursBox" Text="1" MaxLength="3" FontSize="24" FontFamily="Consolas" AutomationProperties.Name="Часы до выключения компьютера" /></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Минуты" Style="{StaticResource TimerMuted}" Margin="0,0,0,7" /><TextBox x:Name="ShutdownMinutesBox" Text="0" MaxLength="2" FontSize="24" FontFamily="Consolas" AutomationProperties.Name="Минуты до выключения компьютера" /></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                      <Button Content="15 мин" Tag="15" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="30 мин" Tag="30" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="1 час" Tag="60" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="2 часа" Tag="120" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                  <Border Grid.Column="2" Background="#0A0A0A" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="18">
                    <StackPanel><TextBlock Text="ОСТАЛОСЬ" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                      <Viewbox Height="58" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" Margin="0,8,0,4"><TextBlock x:Name="ShutdownCountdown" Text="— : — : —" FontSize="40" FontFamily="Consolas" /></Viewbox>
                      <TextBlock x:Name="ShutdownStatus" Text="Таймер не запущен" Style="{StaticResource TimerMuted}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="StartShutdownTimerButton" Content="Запустить таймер" Style="{StaticResource Primary}" Click="StartShutdownTimer_Click" Margin="0,0,12,10" />
                  <Button x:Name="CancelShutdownTimerButton" Content="Отменить таймер" IsEnabled="False" Click="CancelShutdownTimer_Click" Margin="0,0,0,10" />
                </WrapPanel>
                <TextBlock x:Name="ShutdownTimerError" Foreground="#FFD4D8" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Как работает таймер" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Text="• От 1 минуты до 7 дней. Отменить можно до начала выключения.&#x0a;• Windows не будет принудительно закрывать программы. Несохранённые документы могут задержать выключение.&#x0a;• Компьютер должен быть включён, пользователь - оставаться в системе. Таймер не будит ПК и не срабатывает позже пропущенного времени после сна или перезагрузки." Style="{StaticResource TimerMuted}" FontSize="12" />
            </StackPanel></Border>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="LogsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="События приложения" Style="{StaticResource Heading}" /><Button Content="Сохранить журнал" HorizontalAlignment="Right" Click="ExportLog_Click" Padding="14,8" /></Grid><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="490" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Margin="0,12,0,0" /></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer></Border>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><StackPanel><Grid><TextBlock x:Name="StatusText" Text="Подготовка приложения…" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="ProgressCounter" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" /></Grid><ProgressBar x:Name="OperationProgress" Margin="0,10,0,0" Visibility="Collapsed" /></StackPanel></Border>
    </Grid>
  </Grid>
  </Grid></Border>
</Window>
