                <TextBlock Text="На время проверки лучше приостановить скачивания и копирование файлов. Результат зависит от свободного места, температуры и других задач. Можно свернуть окно; полный выход из программы отменит проверку." Style="{StaticResource DiskMuted}" FontSize="12" />
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="SensorToolPanel" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border x:Name="CpuTile" Grid.Column="0" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" MouseLeftButtonUp="SensorTile_Click" ToolTip="Показать на графике">
                    <StackPanel><TextBlock Text="ПРОЦЕССОР · °C" Style="{StaticResource Caption}" /><TextBlock x:Name="CpuTileValue" Text="—" FontSize="24" FontFamily="{StaticResource MonoFont}" Margin="0,6,0,6" /><ProgressBar x:Name="CpuTileBar" Maximum="100" Height="3" /><TextBlock x:Name="CpuTileRating" Text="Ожидание" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
                  </Border>
                  <Border x:Name="GpuTile" Grid.Column="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" MouseLeftButtonUp="SensorTile_Click" ToolTip="Показать на графике">
                    <StackPanel><TextBlock Text="ВИДЕОКАРТА · °C" Style="{StaticResource Caption}" /><TextBlock x:Name="GpuTileValue" Text="—" FontSize="24" FontFamily="{StaticResource MonoFont}" Margin="0,6,0,6" /><ProgressBar x:Name="GpuTileBar" Maximum="100" Height="3" /><TextBlock x:Name="GpuTileRating" Text="Ожидание" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
                  </Border>
                  <Border x:Name="LoadTile" Grid.Column="4" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" MouseLeftButtonUp="SensorTile_Click" ToolTip="Показать на графике">
                    <StackPanel><TextBlock Text="ЗАГРУЗКА ПРОЦЕССОРА" Style="{StaticResource Caption}" /><TextBlock x:Name="LoadTileValue" Text="—" FontSize="24" FontFamily="{StaticResource MonoFont}" Margin="0,6,0,6" /><ProgressBar x:Name="LoadTileBar" Maximum="100" Height="3" /><TextBlock x:Name="LoadTileRating" Text="Ожидание" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
                  </Border>
                  <Border x:Name="MemoryTile" Grid.Column="6" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" MouseLeftButtonUp="SensorTile_Click" ToolTip="Показать на графике">
                    <StackPanel><TextBlock Text="ЗАНЯТО ПАМЯТИ" Style="{StaticResource Caption}" /><TextBlock x:Name="MemoryTileValue" Text="—" FontSize="24" FontFamily="{StaticResource MonoFont}" Margin="0,6,0,6" /><ProgressBar x:Name="MemoryTileBar" Maximum="100" Height="3" /><TextBlock x:Name="MemoryTileRating" Text="Ожидание" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
                  </Border>
                </Grid>
                <CheckBox x:Name="OverheatCheck" Content="Предупреждать о перегреве процессора и видеокарты (выше 90 °C)" Checked="OverheatAlert_Changed" Unchecked="OverheatAlert_Changed" Margin="0,14,0,0" ToolTip="Уведомление появится рядом с часами. Работает, пока идёт сбор показаний." />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Графики датчиков" Style="{StaticResource Heading}" />
                <ComboBox x:Name="SensorPicker" SelectionChanged="Sensor_Changed" AutomationProperties.Name="Датчик на графике" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="SensorValueText" Text="—" FontSize="30" FontFamily="{StaticResource MonoFont}" /><TextBlock x:Name="SensorRangeText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" /></Grid>
                <ui:SensorChart x:Name="SensorPlot" Height="200" Margin="0,0,0,12" />
                <CheckBox x:Name="SensorRecordCheck" ToolTip="Сбор продолжится в других вкладках и при сворачивании к значку рядом с часами. При полном выходе история исчезнет — сохраните таблицу CSV, если она нужна." Content="Продолжать сбор при переключении вкладок и сворачивании" Checked="RecordSensors_Changed" Unchecked="RecordSensors_Changed" Margin="0,0,0,10" />
                <WrapPanel Margin="0,0,0,10"><Button x:Name="SensorCsvButton" Content="Сохранить таблицу CSV" Click="ExportSensors_Click" Margin="0,0,8,6" Visibility="Collapsed" /><Button Content="Очистить историю" Click="ClearSensors_Click" Margin="0,0,0,6" /></WrapPanel>
                <TextBlock x:Name="SensorStatusText" Text="Выберите датчик. Графики появятся после первого опроса." Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Предупреждение по показанию датчика" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <WrapPanel><CheckBox x:Name="SensorAlertCheck" Content="Предупреждать, если значение выше" VerticalAlignment="Center" Margin="0,0,12,8" /><TextBox x:Name="SensorThresholdBox" Text="80" Width="100" MaxLength="16" Margin="0,0,12,8" AutomationProperties.Name="Порог в единицах датчика" /><Button Content="Сохранить предупреждение" Click="SaveSensorAlert_Click" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Укажите значение в единицах выбранного датчика, например 80 для температуры 80 °C. Уведомления работают во время сбора данных. История хранится до полного выхода из программы; сохраните CSV, если хотите её оставить." Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="NetworkToolPanel" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Качество соединения" Style="{StaticResource Heading}" />
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions><TextBox x:Name="QualityTargetBox" ToolTip="Сервер, с которым сравниваем связь. Можно указать IP-адрес или домен, например 1.1.1.1 или example.com." Text="1.1.1.1" MaxLength="253" AutomationProperties.Name="Внешний IP-адрес или домен для проверки" /><ComboBox x:Name="QualityGatewayPicker" ToolTip="Выберите подключение, через которое выходите в интернет. Шлюз — обычно ваш роутер; сравнение помогает проверить домашнюю сеть." Grid.Column="2" AutomationProperties.Name="Шлюз для сравнения задержки" /></Grid>
                <CheckBox x:Name="QualityRouteCheck" Content="Показать путь до сервера" Margin="0,0,0,10" Visibility="Collapsed" />
                <WrapPanel Margin="0,0,0,12"><Button x:Name="QualityStartButton" Content="Проверить соединение" Style="{StaticResource Primary}" Click="StartQuality_Click" Margin="0,0,8,0" /><Button x:Name="NetworkCancelButton" Content="Отменить" Click="CancelExtended_Click" IsEnabled="False" /></WrapPanel>
                <Border x:Name="QualityVerdict" Visibility="Collapsed" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="QualityVerdictBadge" Width="28" Height="28" CornerRadius="14" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,0,12,0"><TextBlock x:Name="QualityVerdictIcon" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="QualityVerdictTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="QualityVerdictDetail" Style="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,3,0,0" /></StackPanel>
                  </Grid>
                </Border>
                <DataGrid x:Name="QualityRowsGrid" Height="108" RowHeight="34" FontSize="11"><DataGrid.Columns><DataGridTextColumn Header="Узел" Binding="{Binding Target}" Width="2*" /><DataGridTextColumn Header="Пинг, мс" Binding="{Binding Ping}" Width="*" /><DataGridTextColumn Header="Джиттер" Binding="{Binding Jitter}" Width="*" /><DataGridTextColumn Header="Потери" Binding="{Binding Loss}" Width="*" /><DataGridTextColumn Header="Мин.–макс." Binding="{Binding Range}" Width="*" /></DataGrid.Columns></DataGrid>
                <TextBlock x:Name="QualityRouteText" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="Пинг — время ответа. Джиттер — насколько это время меняется: меньше — стабильнее. Потери — доля запросов без ответа. Некоторые устройства не отвечают на такие проверки, даже если интернет работает." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Скорость интернета" Style="{StaticResource Heading}" />
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="ЗАГРУЗКА · Мбит/с" Foreground="{DynamicResource MutedBrush}" FontSize="10" /><TextBlock x:Name="SpeedDownText" Text="—" FontSize="34" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="ОТДАЧА · Мбит/с" Foreground="{DynamicResource MutedBrush}" FontSize="10" /><TextBlock x:Name="SpeedUpText" Text="—" FontSize="34" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                </Grid>
                <TextBlock x:Name="SpeedLatencyText" Text="Задержка без нагрузки и во время передачи данных" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" />
                <Border x:Name="SpeedVerdict" Visibility="Collapsed" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="SpeedVerdictBadge" Width="28" Height="28" CornerRadius="14" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,0,12,0"><TextBlock x:Name="SpeedVerdictIcon" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="SpeedVerdictTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SpeedVerdictDetail" Style="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,3,0,0" /></StackPanel>
                  </Grid>
                </Border>
                
                <WrapPanel><ComboBox x:Name="SpeedModePicker" SelectedIndex="0" MinWidth="230" Margin="0,0,10,8" Visibility="Collapsed"><ComboBoxItem Content="Быстрый · до 62 МБ" /><ComboBoxItem Content="Подробный · до 262 МБ" /></ComboBox><Button x:Name="SpeedStartButton" Content="Измерить скорость" Click="StartSpeed_Click" Style="{StaticResource Primary}" Margin="0,0,8,8" /><Button x:Name="SpeedCancelButton" Content="Отменить" Click="CancelExtended_Click" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Измеряем скорость скачивания и отправки данных до сервера Cloudflare. Перед запуском приостановите другие загрузки. Тест расходует до 62 или 262 МБ данных плюс небольшой служебный трафик. На другом сервере скорость может отличаться." Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Если сайты не открываются" Style="{StaticResource Heading}" />
                <TextBlock Text="Сначала попробуйте очистить кэш DNS: это безопасно и занимает секунду. Полный сброс восстанавливает сетевые настройки Windows и помогает, когда другие программы (VPN, ускорители) испортили их. После сброса нужно перезагрузить компьютер." Style="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,0,0,14" />
                <WrapPanel><Button x:Name="FlushDnsButton" Content="Очистить кэш DNS" Style="{StaticResource Primary}" Click="FlushDns_Click" Margin="0,0,8,8" /><Button x:Name="ResetNetworkButton" Content="Полный сброс сети" Click="ResetNetwork_Click" Margin="0,0,0,8" ToolTip="Сброс Winsock и TCP/IP. Вручную заданные IP-адреса и DNS будут сброшены, Wi-Fi и пароли сохранятся. Нужна перезагрузка." /></WrapPanel>
                <TextBlock x:Name="RepairStatusText" Style="{StaticResource Muted}" FontSize="12" LineHeight="19" Visibility="Collapsed" Margin="0,4,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="DNS-сервер" Style="{StaticResource Heading}" />
                <TextBlock Text="DNS превращает адреса сайтов в IP-адреса. Если DNS провайдера работает плохо или подменяет ответы, сайты могут не открываться даже при включённом обходе. Надёжный публичный DNS часто решает проблему." Style="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,0,0,14" />
                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,14"><StackPanel><TextBlock Text="СЕЙЧАС ИСПОЛЬЗУЕТСЯ" Style="{StaticResource Caption}" Margin="0,0,0,6" /><TextBlock x:Name="DnsCurrentText" Text="Определяем…" TextWrapping="Wrap" FontSize="13" LineHeight="20" /></StackPanel></Border>
                <WrapPanel><Button x:Name="DnsCloudflareButton" Content="Cloudflare · 1.1.1.1" Tag="cloudflare" Click="SetDns_Click" Margin="0,0,8,8" /><Button x:Name="DnsGoogleButton" Content="Google · 8.8.8.8" Tag="google" Click="SetDns_Click" Margin="0,0,8,8" /><Button x:Name="DnsAutoButton" Content="Автоматически (как было)" Tag="auto" Click="SetDns_Click" Margin="0,0,8,8" /><Button x:Name="DnsRefreshButton" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" Padding="13,11" ToolTip="Обновить" AutomationProperties.Name="Обновить сведения о DNS" Click="RefreshDns_Click" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Меняется DNS активных подключений. Вернуть прежнюю настройку можно кнопкой «Автоматически». Если используете VPN, он может задавать DNS сам." Style="{StaticResource Muted}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" LineHeight="17" Margin="0,4,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock x:Name="NetworkStageText" Text="Запустите нужную проверку." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" /><WrapPanel><Button x:Name="SaveNetworkButton" Content="Сохранить отчёт" Click="SaveNetwork_Click" IsEnabled="False" /></WrapPanel></StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="SpaceToolPanel" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Что занимает место" Style="{StaticResource Heading}" />
                <WrapPanel x:Name="SpaceDrivesPanel" Margin="0,0,0,6" />
                <TextBox x:Name="SpacePathBox" MaxLength="32767" AutomationProperties.Name="Папка для анализа занятого места" Margin="0,0,0,10" />
                <WrapPanel Margin="0,0,0,10"><Button x:Name="SpaceStartButton" Content="Анализировать" Style="{StaticResource Primary}" Click="StartSpace_Click" Margin="0,0,8,8" /><Button x:Name="SpaceBrowseButton" Content="Выбрать папку" Click="BrowseSpace_Click" Margin="0,0,8,8" /><Button x:Name="SpaceParentButton" Content="На уровень выше" Click="ParentSpace_Click" Margin="0,0,8,8" /><Button x:Name="SpaceCancelButton" Content="Отменить" Click="CancelExtended_Click" Margin="0,0,0,8" IsEnabled="False" /></WrapPanel>
                <TextBlock x:Name="SpaceStatusText" Text="Выберите накопитель или папку." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
                <TextBlock Text="ПАПКИ · откройте двойным щелчком" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                <DataGrid x:Name="SpaceFolderGrid" SelectionChanged="SpaceSelection_Changed" Height="240" FontSize="11" MouseDoubleClick="SpaceFolder_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Папка" Binding="{Binding Path}" Width="2*" /><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100" /><DataGridTemplateColumn Header="Доля" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="4,8"><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="18" Opacity="0.3" /><TextBlock Text="{Binding Share}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                <Button x:Name="SpaceOpenButton" Content="Показать выбранное в проводнике" Click="OpenSpace_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="100 крупнейших файлов" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" /><DataGrid x:Name="SpaceFilesGrid" SelectionChanged="SpaceSelection_Changed" Height="240" FontSize="11"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="110" /></DataGrid.Columns></DataGrid><Button Content="Показать файл в проводнике" Click="OpenSpace_Click" HorizontalAlignment="Left" Margin="0,12,0,0" /><TextBlock Text="Показываем размеры доступных файлов, поэтому сумма может отличаться от занятого места в свойствах диска. Недоступные папки и ссылки пропускаются. Поиск длится до 10 минут; при отмене найденные результаты остаются. Файлы не изменяются." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
                <TextBlock Text="Освободить место" Style="{StaticResource Heading}" />
                <TextBlock Text="Удаляем только то, что безопасно: временные файлы, скачанные обновления, кэш графики и корзину. Ваши документы, фото и программы не затрагиваются. Свежие временные файлы, которые могут быть заняты, пропускаются." Style="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,0,0,12" />
                <StackPanel x:Name="CleanupList" />
                <WrapPanel Margin="0,12,0,0"><Button x:Name="CleanupScanButton" Content="Посчитать" Click="EstimateCleanup_Click" Margin="0,0,8,8" /><Button x:Name="CleanupButton" Content="Очистить выбранное" Style="{StaticResource Primary}" Click="Cleanup_Click" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock x:Name="CleanupStatusText" Text="Нажмите «Посчитать», чтобы узнать, сколько места можно освободить." Style="{StaticResource Muted}" FontSize="12" LineHeight="19" />
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="ShutdownToolPanel" Visibility="Collapsed"><StackPanel.Resources><Style x:Key="TimerMuted" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="LineHeight" Value="18" /></Style></StackPanel.Resources>
            <Border Style="{StaticResource Card}" Padding="22">
              <StackPanel>
                <WrapPanel Margin="0,0,0,6"><Button x:Name="TimerShutdownButton" Content="Выключение" Tag="Shutdown" Style="{StaticResource ChipActive}" Click="TimerAction_Click" /><Button x:Name="TimerRestartButton" Content="Перезагрузка" Tag="Restart" Style="{StaticResource Chip}" Click="TimerAction_Click" /><Button x:Name="TimerSleepButton" Content="Сон" Tag="Sleep" Style="{StaticResource Chip}" Click="TimerAction_Click" /></WrapPanel>
                <TextBlock x:Name="TimerHeading" Text="Выключение по таймеру" Style="{StaticResource Heading}" />
                <TextBlock x:Name="TimerDescription" Text="Выберите, через сколько выключить компьютер. Таймер продолжит работать, даже если закрыть x2zapret." Style="{StaticResource TimerMuted}" Margin="0,0,0,12" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="24" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Часы" Style="{StaticResource TimerMuted}" Margin="0,0,0,7" /><TextBox x:Name="ShutdownHoursBox" Text="1" MaxLength="3" FontSize="24" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Часы до выключения компьютера" /></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Минуты" Style="{StaticResource TimerMuted}" Margin="0,0,0,7" /><TextBox x:Name="ShutdownMinutesBox" Text="0" MaxLength="2" FontSize="24" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Минуты до выключения компьютера" /></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                      <Button Content="15 мин" Tag="15" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="30 мин" Tag="30" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="1 час" Tag="60" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="2 часа" Tag="120" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                  <Border Grid.Column="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="18">
                    <StackPanel><TextBlock Text="ОСТАЛОСЬ" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                      <Viewbox Height="58" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" Margin="0,8,0,4"><TextBlock x:Name="ShutdownCountdown" Text="— : — : —" FontSize="40" FontFamily="{StaticResource MonoFont}" /></Viewbox>
                      <TextBlock x:Name="ShutdownStatus" Text="Таймер не запущен" Style="{StaticResource TimerMuted}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="StartShutdownTimerButton" Content="Запустить таймер" Style="{StaticResource Primary}" Click="StartShutdownTimer_Click" Margin="0,0,12,10" />
                  <Button x:Name="CancelShutdownTimerButton" Content="Отменить таймер" IsEnabled="False" Click="CancelShutdownTimer_Click" Margin="0,0,0,10" />
                </WrapPanel>
                <TextBlock x:Name="ShutdownTimerError" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Как работает таймер" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Text="• От 1 минуты до 7 дней. Отменить можно до начала выключения.&#x0a;• Windows не будет принудительно закрывать программы. Несохранённые документы могут задержать выключение.&#x0a;• Сон срабатывает, только если он разрешён в настройках электропитания Windows.&#x0a;• Компьютер должен быть включён, пользователь — оставаться в системе. Таймер не будит ПК и не срабатывает позже пропущенного времени после сна или перезагрузки." Style="{StaticResource TimerMuted}" FontSize="12" />
            </StackPanel></Border>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="LogsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="События приложения" Style="{StaticResource Heading}" /><Button Content="Сохранить журнал" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" Click="ExportLog_Click" Padding="14,8" /></Grid><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="490" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0" Padding="16,14" Margin="0,8,0,0" /></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer></Border>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"><StackPanel><Grid><TextBlock x:Name="StatusText" Text="Подготовка приложения…" FontSize="12" Style="{StaticResource Muted}" LineHeight="18" Margin="0,0,90,0" /><TextBlock x:Name="ProgressCounter" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" FontSize="12" /></Grid><ProgressBar x:Name="OperationProgress" Margin="0,10,0,0" Height="3" Visibility="Collapsed" /></StackPanel></Border>
    </Grid>
  </Grid>
  </Grid></Border>
</Window>
