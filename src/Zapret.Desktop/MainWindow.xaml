<Window x:Class="Zapret.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:ui="clr-namespace:Zapret.Desktop.Runtime"
        Title="x2zapret" Style="{StaticResource {x:Type Window}}" Width="1280" Height="900" MinWidth="1040" MinHeight="760" WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#303030" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Background="#090909"><TextBlock Text="X2AIR  /  x2zapret" FontFamily="Consolas" Foreground="#929292" FontSize="10" VerticalAlignment="Center" Margin="22,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="─" Width="44" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Свернуть" Click="Minimize_Click" />
        <Button Content="□" Width="44" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Развернуть или восстановить" Click="Maximize_Click" />
        <Button Content="×" FontSize="21" Width="44" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Закрыть" Click="Close_Click" />
      </StackPanel>
    </Grid>
  <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,28,20,20">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,10,25">
          <Image Source="{StaticResource BrandLogo}" Width="88" Height="108" Stretch="Uniform" HorizontalAlignment="Left" Margin="-8,-6,0,12"><Image.Effect><DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="10" Opacity="0.2" /></Image.Effect></Image>
          <TextBlock Text="x2zapret" FontSize="29" FontWeight="Black" FontStyle="Italic" />
          <TextBlock Text="X2AIR  /  CONNECTION UTILITY" FontFamily="Consolas" FontSize="8" Foreground="#898989" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="10,20,0,0"><Border Background="#1A1A1A" CornerRadius="3" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="WINDOWS 10 / 11 · x64" FontSize="10" Foreground="#CBCBCB" /></Border><TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" /><TextBlock x:Name="AuthorText" Text="by Zuya" FontSize="11" Foreground="#CBCBCB" Margin="0,5,0,5" /><TextBlock Text="На основе zapret и профилей Flowseal" FontSize="10" Style="{StaticResource Muted}" /></StackPanel>
        <ScrollViewer ui:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Border x:Name="NavigationMarker" Width="2" Height="24" CornerRadius="1" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1" IsHitTestVisible="False" /><StackPanel x:Name="NavigationPanel">
          <Button Content="◉    Обзор" Style="{StaticResource Nav}" Tag="Home" Click="Navigate_Click" />
          <Button Content="↗    Автоподбор" Style="{StaticResource Nav}" Tag="Tests" Click="Navigate_Click" />
          <Button Content="≡    Профили" Style="{StaticResource Nav}" Tag="Strategies" Click="Navigate_Click" />
          <Button Content="◇    Диагностика" Style="{StaticResource Nav}" Tag="Diagnostics" Click="Navigate_Click" />
          <Button Content="⊞    X2 Tools" Style="{StaticResource Nav}" Tag="Tools" Click="Navigate_Click" />
          <Button Content="⚙    Настройки" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate_Click" />
          <Button Content="▤    Журнал" Style="{StaticResource Nav}" Tag="Logs" Click="Navigate_Click" />
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="10,22" />
          <Button Content="↗    GitHub проекта" Style="{StaticResource Nav}" Click="GitHub_Click" />
        </StackPanel></Grid></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="36,28,36,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="PageHeading" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="30" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitle" Text="Включите обход и проверьте доступ к сайтам." Style="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#303030" BorderThickness="1" CornerRadius="3" Padding="12,8"><TextBlock Text="X2AIR / DESKTOP" FontFamily="Consolas" FontSize="10" Foreground="#A0A0A0" /></Border></Grid>
      <Border x:Name="ErrorBanner" Grid.Row="1" Background="#51252C" CornerRadius="5" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFD4D8" /></Border>
      <Border Grid.Row="2" ClipToBounds="True"><ScrollViewer x:Name="PageScroll" ui:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <Grid>
          <StackPanel x:Name="HomePanel">
            <Border BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18" ClipToBounds="True">
              <Grid Height="214">
                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7"><GradientStop Color="#1A1A1A" Offset="0" /><GradientStop Color="#080808" Offset="1" /></LinearGradientBrush></Grid.Background>
                <Rectangle Fill="{StaticResource GrainBrush}" IsHitTestVisible="False" />
                <Image Source="{StaticResource BrandEmblem}" Width="244" Height="220" HorizontalAlignment="Right" Margin="0,-5,24,0" Opacity="0.75" Stretch="Uniform"><Image.Effect><DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.3" /></Image.Effect></Image>
                <StackPanel VerticalAlignment="Center" Margin="30,0,270,0">
                  <TextBlock Text="X2AIR  /  NETWORK CONTROL" FontFamily="Consolas" FontSize="10" Foreground="#A9A9A9" />
                  <TextBlock Text="x2zapret" FontSize="58" FontWeight="Black" FontStyle="Italic" Margin="-3,3,0,6" />
                  <TextBlock Text="Твоя сеть. Твои правила." FontSize="15" Foreground="#A4A4A4" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="30"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="СОСТОЯНИЕ ПОДКЛЮЧЕНИЯ" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Margin="0,18,0,10"><Ellipse x:Name="StateDot" Width="12" Height="12" Fill="#777777" Margin="0,0,12,0" /><TextBlock x:Name="ConnectionTitle" Text="Обход отключён" FontSize="26" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Выберите профиль или запустите автоподбор." Style="{StaticResource Muted}" /><TextBlock x:Name="ActiveStrategyText" Text="Текущий профиль: —" Margin="0,22,0,0" FontSize="13" /></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><Button x:Name="ConnectButton" Content="Включить обход" Style="{StaticResource Primary}" FontSize="17" Padding="26,20" Click="Connect_Click" /><TextBlock Text="Если Windows запросит разрешение, нажмите «Да»." FontSize="11" TextAlignment="Center" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel>
            </Grid></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Найдём подходящий профиль" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Программа проверит готовые профили и предложит подходящий для вашей сети." Style="{StaticResource Muted}" Margin="0,10,0,20" /><Button Content="Запустить автоподбор  →" Tag="Tests" HorizontalAlignment="Left" Click="Navigate_Click" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Фоновое подключение" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ServiceText" Text="Включите эту настройку, чтобы обход работал после полного выхода из программы." Style="{StaticResource Muted}" Margin="0,10,0,20" /><Button x:Name="ServiceButton" Content="Включить фоновое подключение" HorizontalAlignment="Left" Click="Service_Click" /></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Профиль подключения" Style="{StaticResource Heading}" /><ComboBox x:Name="HomeStrategyPicker" SelectionChanged="HomeStrategy_Changed" /><TextBlock x:Name="StrategyDescription" Style="{StaticResource Muted}" Margin="0,10,0,0" /><TextBlock Text="Включённый обход ещё не означает, что сайты доступны. Программа проверяет их отдельно; просмотр видео и голосовой чат проверяйте в самих сервисах." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="TestsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Подбор профиля подключения" Style="{StaticResource Heading}" /><TextBlock Text="Сначала проверим интернет без обхода, затем попробуем разные профили. Лучшие варианты проверим ещё раз." Style="{StaticResource Muted}" /><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="TestModePicker" ToolTip="Быстрый режим проверит несколько профилей. Полный — все профили. Режим DPI дополнительно проверит передачу тестовых данных." SelectedIndex="0"><ComboBoxItem Content="Быстрый · 5 профилей" /><ComboBoxItem x:Name="FullTestModeItem" Content="Полный · все профили" /><ComboBoxItem Content="Передача данных · DPI" /></ComboBox><Button x:Name="StartTestsButton" Grid.Column="2" Content="Начать проверку" Style="{StaticResource Primary}" Click="StartTests_Click" /><Button x:Name="CancelTestsButton" Grid.Column="4" Content="Отмена" IsEnabled="False" Click="CancelTests_Click" /></Grid><CheckBox x:Name="OnlySelectedCheck" Content="Проверить только выбранный профиль" /><TextBlock Text="Во время подбора интернет может ненадолго прерываться. Результат подходит для сети, к которой вы подключены сейчас. Видео и голосовой чат проверяйте отдельно." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="RecommendationTitle" Text="Результаты появятся здесь" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="RecommendationDetail" Text="Нажмите «Начать проверку», чтобы подобрать профиль." Style="{StaticResource Muted}" Margin="0,9,0,16" /><StackPanel Orientation="Horizontal"><Button x:Name="ApplyRecommendedButton" Content="Включить рекомендованный профиль" IsEnabled="False" Click="ApplyRecommended_Click" Style="{StaticResource Primary}" Margin="0,0,12,0" /><Button x:Name="ExportTestsButton" Content="Сохранить отчёт" IsEnabled="False" Click="ExportTests_Click" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="Проверки соединения" FontSize="18" FontWeight="SemiBold" Margin="8,4,0,12" /><DataGrid x:Name="ProbeGrid" Height="320"><DataGrid.Columns><DataGridTextColumn Header="Профиль" Binding="{Binding Strategy}" Width="1.15*" /><DataGridTextColumn Header="Сервис / сервер" Binding="{Binding Target}" Width="1.2*" /><DataGridTextColumn Header="Проверка" Binding="{Binding Protocol}" Width="90" /><DataGridTextColumn Header="Результат" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="мс" Binding="{Binding Latency}" Width="70" /></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle></DataGrid></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="StrategiesPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Готовые профили подключения" Style="{StaticResource Heading}" /><TextBlock Text="Здесь собраны профили Flowseal из этой версии программы. Выбранный профиль начнёт работать после следующего включения обхода." Style="{StaticResource Muted}" /><DataGrid x:Name="StrategiesGrid" Height="440" Margin="0,18,0,18"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.1*" /><DataGridTextColumn Header="Исходный файл" Binding="{Binding Source}" Width="1.3*" /><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="1.7*" /></DataGrid.Columns></DataGrid><Button x:Name="ChooseStrategyButton" Content="Выбрать профиль" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="ChooseStrategy_Click" /></StackPanel></Border></StackPanel>
          <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Проверка программы и Windows" Style="{StaticResource Heading}" /><TextBlock Text="Проверим необходимые файлы и службы Windows. Если обнаружится проблема, ниже появится объяснение. Изменения запускаются отдельными кнопками." Style="{StaticResource Muted}" /><WrapPanel Margin="0,18,0,18"><Button x:Name="DiagnoseButton" Content="Проверить систему" Style="{StaticResource Primary}" Click="Diagnose_Click" Margin="0,0,10,10" /><Button x:Name="ClearCacheButton" Content="Очистить кэш Discord" Click="ClearCache_Click" Margin="0,0,10,10" /><Button x:Name="TimestampsButton" Content="Включить TCP timestamps" Click="Timestamps_Click" Margin="0,0,10,10" /><Button Content="Открыть службы Windows" Click="OpenServices_Click" Margin="0,0,0,10" /></WrapPanel><DataGrid x:Name="DiagnosticsGrid" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="150" /><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="Описание" Binding="{Binding Detail}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Доступность сервисов" Style="{StaticResource Heading}" />
              <TextBlock Text="Проверяем, отвечают ли сайты и серверы Discord и YouTube. Это не проверка воспроизведения видео или голосового чата." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
              <Button Content="Проверить доступность сейчас" Click="CheckConnection_Click" HorizontalAlignment="Left" Margin="0,0,0,12" />
              <DataGrid x:Name="HealthChecksGrid" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Сервис" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*" /><DataGridTextColumn Header="Ответ" Binding="{Binding Latency}" Width="85" /><DataGridTextColumn Header="Подробности" Binding="{Binding Detail}" Width="*" /></DataGrid.Columns></DataGrid>
            </StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Контроль подключения" Style="{StaticResource Heading}" />
              <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="Проверять доступность сервисов" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Проверять Discord, YouTube и другие сайты каждые 45 секунд. Работает, пока программа открыта или свёрнута к значку рядом с часами." Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
                <CheckBox x:Name="MonitorConnectionSwitch" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="Проверять доступность сервисов" />
              </Grid>
              <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="Умное переподключение" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Если доступ пропал, попробовать восстановить его и подобрать другой профиль. После ручного отключения обход не включится сам. При отсутствии интернета профили не перебираются." Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
                <CheckBox x:Name="AutoReconnectSwitch" ToolTip="Восстановление начинается после трёх неудачных проверок за период не короче 75 секунд, если контрольный сайт отвечает. До 3 попыток за 15 минут; пауза между ними — от 2 минут." Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="Умное переподключение" />
              </Grid>
              <Button x:Name="SaveConnectionMonitorButton" Content="Сохранить настройки подключения" Click="SaveConnectionMonitor_Click" HorizontalAlignment="Left" />
            </StackPanel></Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Запуск приложения" Style="{StaticResource Heading}" />
                <TextBlock Text="Выберите, как x2zapret будет запускаться при входе в Windows." Style="{StaticResource Muted}" Margin="0,0,0,22" />
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Запускать вместе с Windows в фоне" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" /><TextBlock Text="Окно не откроется. Значок программы появится рядом с часами — в области уведомлений Windows." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                  <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="Запускать вместе с Windows в фоне" Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed" />
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,20" />
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Автоматически подключаться" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="При входе в Windows сразу включать обход с последним выбранным профилем." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                  <CheckBox x:Name="StartupConnectSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="False" AutomationProperties.Name="Автоматически подключаться при запуске с Windows" />
                </Grid>
                <TextBlock Text="Подключение без открытой программы через службу Windows работает отдельно. Если он включён, подключение может быть запущено ещё до открытия приложения." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18" />
                <Button x:Name="SaveStartupButton" Content="Сохранить автозапуск" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveStartup_Click" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Обновление приложения" Style="{StaticResource Heading}" />
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Проверять обновления автоматически" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="Искать новую версию при запуске и каждые 6 часов. Программа спросит разрешение перед скачиванием и установкой." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                  <CheckBox x:Name="AutoUpdateSwitch" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Автоматически проверять обновления приложения" />
                </Grid>
                <TextBlock x:Name="UpdateStatusText" Text="Новые версии загружаются со страницы x2zapret на GitHub." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" />
                <WrapPanel>
                  <Button x:Name="SaveAutoUpdateButton" Content="Сохранить" Click="SaveAutoUpdate_Click" Margin="0,0,10,10" />
                  <Button x:Name="CheckUpdatesButton" Content="Проверить сейчас" Click="CheckUpdates_Click" Margin="0,0,10,10" />
                  <Button x:Name="InstallUpdateButton" Content="Скачать и установить" Style="{StaticResource Primary}" IsEnabled="False" Click="InstallUpdate_Click" Margin="0,0,10,10" />
                  <Button x:Name="CancelUpdateButton" Content="Отменить загрузку" IsEnabled="False" Click="CancelUpdate_Click" Margin="0,0,0,10" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Дополнительные настройки подключения" Style="{StaticResource Heading}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Список IP-адресов" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox x:Name="IpSetPicker" ToolTip="Дополнительный список адресов для обхода. Обычно можно оставить вариант «Не использовать список IP»." SelectedIndex="0"><ComboBoxItem Content="Не использовать список IP" /><ComboBoxItem Content="Использовать список IP" /><ComboBoxItem Content="Обрабатывать все IP-адреса" /></ComboBox><TextBlock Text="Порты TCP для игр" Style="{StaticResource Muted}" Margin="0,16,0,6" /><TextBox x:Name="TcpPortsBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Обход для игр" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox x:Name="GameFilterPicker" ToolTip="TCP и UDP — два способа передачи данных в сети. Если не знаете, какой нужен вашей игре, оставьте текущую настройку." SelectedIndex="0"><ComboBoxItem Content="Выключен" /><ComboBoxItem Content="TCP и UDP" /><ComboBoxItem Content="Только TCP" /><ComboBoxItem Content="Только UDP" /></ComboBox><TextBlock Text="Порты UDP для игр" Style="{StaticResource Muted}" Margin="0,16,0,6" /><TextBox x:Name="UdpPortsBox" /></StackPanel></Grid><TextBlock Text="Обычно эти настройки менять не нужно. Вариант «Все IP-адреса» затрагивает больше соединений. После изменения проверьте игры и обычные сайты." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" /><CheckBox x:Name="TrayCheck" Content="При закрытии окна оставлять программу рядом с часами" /><TextBlock Text="Служебный пакет Discord (UDP)" Style="{StaticResource Muted}" Margin="0,14,0,6" /><ComboBox x:Name="DiscordFakePicker" ToolTip="Готовые служебные данные для работы обхода. Обычно менять выбранный файл не нужно." /><TextBlock Text="Служебный пакет для игр (UDP)" Style="{StaticResource Muted}" Margin="0,14,0,6" /><ComboBox x:Name="GameFakePicker" ToolTip="Готовые служебные данные для работы обхода в играх. Обычно менять выбранный файл не нужно." /><Button x:Name="SaveSettingsButton" Content="Сохранить и применить" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click" /></StackPanel></Border>
