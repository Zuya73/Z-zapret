<Window x:Class="Zapret.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:ui="clr-namespace:Zapret.Desktop.Runtime"
        Title="x2zapret" Style="{StaticResource {x:Type Window}}" Width="1280" Height="900" MinWidth="1040" MinHeight="760" WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#303030" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Background="#090909"><TextBlock Text="X2AIR  /  x2zapret" FontFamily="Consolas" Foreground="#929292" FontSize="10" VerticalAlignment="Center" Margin="22,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="─" Width="44" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Свернуть" Click="Minimize_Click" />
        <Button Content="□" Width="44" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Развернуть или восстановить" Click="Maximize_Click" />
        <Button Content="×" FontSize="21" Width="44" Padding="0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Закрыть" Click="Close_Click" />
      </StackPanel>
    </Grid>
  <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,28,20,20">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,10,25">
          <Image Source="{StaticResource BrandLogo}" Width="88" Height="108" Stretch="Uniform" HorizontalAlignment="Left" Margin="-8,-6,0,12"><Image.Effect><DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="10" Opacity="0.2" /></Image.Effect></Image>
          <TextBlock Text="x2zapret" FontSize="29" FontWeight="Black" FontStyle="Italic" />
          <TextBlock Text="X2AIR  /  CONNECTION UTILITY" FontFamily="Consolas" FontSize="8" Foreground="#898989" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="10,20,0,0"><Border Background="#1A1A1A" CornerRadius="3" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="WINDOWS 10 / 11 · x64" FontSize="10" Foreground="#CBCBCB" /></Border><TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" /><TextBlock x:Name="AuthorText" Text="by Zuya" FontSize="11" Foreground="#CBCBCB" Margin="0,5,0,5" /><TextBlock Text="Движок zapret · профили Flowseal" FontSize="10" Style="{StaticResource Muted}" /></StackPanel>
        <ScrollViewer ui:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Border x:Name="NavigationMarker" Width="2" Height="24" CornerRadius="1" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1" IsHitTestVisible="False" /><StackPanel x:Name="NavigationPanel">
          <Button Content="◉    Обзор" Style="{StaticResource Nav}" Tag="Home" Click="Navigate_Click" />
          <Button Content="↗    Автоподбор" Style="{StaticResource Nav}" Tag="Tests" Click="Navigate_Click" />
          <Button Content="≡    Стратегии" Style="{StaticResource Nav}" Tag="Strategies" Click="Navigate_Click" />
          <Button Content="◇    Диагностика" Style="{StaticResource Nav}" Tag="Diagnostics" Click="Navigate_Click" />
          <Button Content="⊞    X2 Tools" Style="{StaticResource Nav}" Tag="Tools" Click="Navigate_Click" />
          <Button Content="⚙    Настройки" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate_Click" />
          <Button Content="▤    Журнал" Style="{StaticResource Nav}" Tag="Logs" Click="Navigate_Click" />
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="10,22" />
          <Button Content="↗    GitHub проекта" Style="{StaticResource Nav}" Click="GitHub_Click" />
        </StackPanel></Grid></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="36,28,36,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="PageHeading" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="30" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitle" Text="Ваше подключение. Ваши правила." Style="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#303030" BorderThickness="1" CornerRadius="3" Padding="12,8"><TextBlock Text="X2AIR / DESKTOP" FontFamily="Consolas" FontSize="10" Foreground="#A0A0A0" /></Border></Grid>
      <Border x:Name="ErrorBanner" Grid.Row="1" Background="#51252C" CornerRadius="5" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFD4D8" /></Border>
      <Border Grid.Row="2" ClipToBounds="True"><ScrollViewer x:Name="PageScroll" ui:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <Grid>
          <StackPanel x:Name="HomePanel">
            <Border BorderBrush="#292929" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18" ClipToBounds="True">
              <Grid Height="214">
                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7"><GradientStop Color="#1A1A1A" Offset="0" /><GradientStop Color="#080808" Offset="1" /></LinearGradientBrush></Grid.Background>
                <Rectangle Fill="{StaticResource GrainBrush}" IsHitTestVisible="False" />
                <Image Source="{StaticResource BrandEmblem}" Width="244" Height="220" HorizontalAlignment="Right" Margin="0,-5,24,0" Opacity="0.75" Stretch="Uniform"><Image.Effect><DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.3" /></Image.Effect></Image>
                <StackPanel VerticalAlignment="Center" Margin="30,0,270,0">
                  <TextBlock Text="X2AIR  /  NETWORK CONTROL" FontFamily="Consolas" FontSize="10" Foreground="#A9A9A9" />
                  <TextBlock Text="x2zapret" FontSize="58" FontWeight="Black" FontStyle="Italic" Margin="-3,3,0,6" />
                  <TextBlock Text="Твоя сеть. Твои правила." FontSize="15" Foreground="#A4A4A4" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="30"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="СОСТОЯНИЕ ПОДКЛЮЧЕНИЯ" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Margin="0,18,0,10"><Ellipse x:Name="StateDot" Width="12" Height="12" Fill="#777777" Margin="0,0,12,0" /><TextBlock x:Name="ConnectionTitle" Text="Готов к запуску" FontSize="26" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Выберите стратегию или запустите автоподбор." Style="{StaticResource Muted}" /><TextBlock x:Name="ActiveStrategyText" Text="Активная стратегия: —" Margin="0,22,0,0" FontSize="13" /></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><Button x:Name="ConnectButton" Content="Включить" Style="{StaticResource Primary}" FontSize="17" Padding="26,20" Click="Connect_Click" /><TextBlock Text="Для работы нужен доступ администратора" FontSize="11" TextAlignment="Center" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel>
            </Grid></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Найдём подходящий профиль" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Приложение проверит соединение и сравнит стратегии на вашей сети." Style="{StaticResource Muted}" Margin="0,10,0,20" /><Button Content="Запустить автоподбор  →" Tag="Tests" HorizontalAlignment="Left" Click="Navigate_Click" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Автозапуск движка" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ServiceText" Text="Движок запускается вручную. Автозапуск можно включить одной кнопкой." Style="{StaticResource Muted}" Margin="0,10,0,20" /><Button x:Name="ServiceButton" Content="Включить автозапуск" HorizontalAlignment="Left" Click="Service_Click" /></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Текущая стратегия" Style="{StaticResource Heading}" /><ComboBox x:Name="HomeStrategyPicker" SelectionChanged="HomeStrategy_Changed" /><TextBlock x:Name="StrategyDescription" Style="{StaticResource Muted}" Margin="0,10,0,0" /><TextBlock Text="Состояние движка и доступность сервисов проверяются отдельно. Доступный сайт не гарантирует работу видео, QUIC или голосового чата." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="TestsPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Подбор под вашу сеть" Style="{StaticResource Heading}" /><TextBlock Text="Сначала проверим соединение без обхода, затем сравним профили. Лучшие результаты проверим повторно." Style="{StaticResource Muted}" /><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="TestModePicker" SelectedIndex="0"><ComboBoxItem Content="Быстрый · 5 профилей" /><ComboBoxItem x:Name="FullTestModeItem" Content="Полный · все профили" /><ComboBoxItem Content="DPI · передача данных" /></ComboBox><Button x:Name="StartTestsButton" Grid.Column="2" Content="Начать проверку" Style="{StaticResource Primary}" Click="StartTests_Click" /><Button x:Name="CancelTestsButton" Grid.Column="4" Content="Отмена" IsEnabled="False" Click="CancelTests_Click" /></Grid><CheckBox x:Name="OnlySelectedCheck" Content="Проверить только выбранную стратегию" /><TextBlock Text="Во время перебора подключение может прерываться. Результат относится к текущей сети. Голосовой Discord и воспроизведение видео этими запросами не проверяются." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="RecommendationTitle" Text="Результаты появятся здесь" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="RecommendationDetail" Text="Запустите проверку, чтобы сравнить стратегии." Style="{StaticResource Muted}" Margin="0,9,0,16" /><StackPanel Orientation="Horizontal"><Button x:Name="ApplyRecommendedButton" Content="Применить рекомендацию" IsEnabled="False" Click="ApplyRecommended_Click" Style="{StaticResource Primary}" Margin="0,0,12,0" /><Button x:Name="ExportTestsButton" Content="Сохранить отчёт" IsEnabled="False" Click="ExportTests_Click" /></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="Проверки соединения" FontSize="18" FontWeight="SemiBold" Margin="8,4,0,12" /><DataGrid x:Name="ProbeGrid" Height="320"><DataGrid.Columns><DataGridTextColumn Header="Стратегия" Binding="{Binding Strategy}" Width="1.15*" /><DataGridTextColumn Header="Ресурс" Binding="{Binding Target}" Width="1.2*" /><DataGridTextColumn Header="Проверка" Binding="{Binding Protocol}" Width="90" /><DataGridTextColumn Header="Результат" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="мс" Binding="{Binding Latency}" Width="70" /></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle></DataGrid></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="StrategiesPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Все профили Flowseal" Style="{StaticResource Heading}" /><TextBlock Text="Сохранены все профили закреплённого релиза Flowseal. Выбор профиля применяется при следующем запуске движка." Style="{StaticResource Muted}" /><DataGrid x:Name="StrategiesGrid" Height="440" Margin="0,18,0,18"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.1*" /><DataGridTextColumn Header="Исходный файл" Binding="{Binding Source}" Width="1.3*" /><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="1.7*" /></DataGrid.Columns></DataGrid><Button x:Name="ChooseStrategyButton" Content="Выбрать стратегию" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="ChooseStrategy_Click" /></StackPanel></Border></StackPanel>
          <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Проверка окружения" Style="{StaticResource Heading}" /><TextBlock Text="Покажем состояние компонентов и возможные конфликты. Исправления запускаются отдельными действиями." Style="{StaticResource Muted}" /><WrapPanel Margin="0,18,0,18"><Button x:Name="DiagnoseButton" Content="Проверить систему" Style="{StaticResource Primary}" Click="Diagnose_Click" Margin="0,0,10,10" /><Button x:Name="ClearCacheButton" Content="Очистить кэш Discord" Click="ClearCache_Click" Margin="0,0,10,10" /><Button x:Name="TimestampsButton" Content="Включить TCP timestamps" Click="Timestamps_Click" Margin="0,0,10,10" /><Button Content="Открыть службы Windows" Click="OpenServices_Click" Margin="0,0,0,10" /></WrapPanel><DataGrid x:Name="DiagnosticsGrid" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="150" /><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="Описание" Binding="{Binding Detail}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Запуск приложения" Style="{StaticResource Heading}" />
                <TextBlock Text="Выберите, как x2zapret будет запускаться при входе в Windows." Style="{StaticResource Muted}" Margin="0,0,0,22" />
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Запускать вместе с Windows в трее" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" /><TextBlock Text="Без открытия основного окна. Значок появится рядом с часами." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                  <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="Запускать вместе с Windows в трее" Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed" />
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,20" />
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Автоматически подключаться" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="При запуске с Windows включать последнюю выбранную стратегию." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                  <CheckBox x:Name="StartupConnectSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="False" AutomationProperties.Name="Автоматически подключаться при запуске с Windows" />
                </Grid>
                <TextBlock Text="Автозапуск движка через службу Windows работает отдельно. Если он включён, подключение может быть запущено ещё до открытия приложения." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18" />
                <Button x:Name="SaveStartupButton" Content="Сохранить автозапуск" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveStartup_Click" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Обновление приложения" Style="{StaticResource Heading}" />
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Автообновление приложения" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="Проверять новые версии при запуске и каждые 6 часов. Установка — только с вашего подтверждения." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                  <CheckBox x:Name="AutoUpdateSwitch" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Автоматически проверять обновления приложения" />
                </Grid>
                <TextBlock x:Name="UpdateStatusText" Text="Обновления загружаются из стабильных релизов x2zapret на GitHub." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" />
                <WrapPanel>
                  <Button x:Name="SaveAutoUpdateButton" Content="Сохранить" Click="SaveAutoUpdate_Click" Margin="0,0,10,10" />
                  <Button x:Name="CheckUpdatesButton" Content="Проверить сейчас" Click="CheckUpdates_Click" Margin="0,0,10,10" />
                  <Button x:Name="InstallUpdateButton" Content="Скачать и установить" Style="{StaticResource Primary}" IsEnabled="False" Click="InstallUpdate_Click" Margin="0,0,10,10" />
                  <Button x:Name="CancelUpdateButton" Content="Отменить загрузку" IsEnabled="False" Click="CancelUpdate_Click" Margin="0,0,0,10" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Фильтрация трафика" Style="{StaticResource Heading}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IPSet" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox x:Name="IpSetPicker" SelectedIndex="0"><ComboBoxItem Content="Выключен · none" /><ComboBoxItem Content="Адреса из списка · loaded" /><ComboBoxItem Content="Любой адрес · any" /></ComboBox><TextBlock Text="TCP-порты игрового фильтра" Style="{StaticResource Muted}" Margin="0,16,0,6" /><TextBox x:Name="TcpPortsBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Игровой фильтр" Style="{StaticResource Muted}" Margin="0,0,0,6" /><ComboBox x:Name="GameFilterPicker" SelectedIndex="0"><ComboBoxItem Content="Выключен" /><ComboBoxItem Content="TCP и UDP" /><ComboBoxItem Content="Только TCP" /><ComboBoxItem Content="Только UDP" /></ComboBox><TextBlock Text="UDP-порты игрового фильтра" Style="{StaticResource Muted}" Margin="0,16,0,6" /><TextBox x:Name="UdpPortsBox" /></StackPanel></Grid><TextBlock Text="Режим any затрагивает больше соединений. Используйте его при необходимости и проверяйте обычные сайты после изменения настроек." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" /><CheckBox x:Name="TrayCheck" Content="Сворачивать приложение в трей при закрытии окна" /><TextBlock Text="Фейк для Discord UDP" Style="{StaticResource Muted}" Margin="0,14,0,6" /><ComboBox x:Name="DiscordFakePicker" /><TextBlock Text="Фейк для игрового UDP" Style="{StaticResource Muted}" Margin="0,14,0,6" /><ComboBox x:Name="GameFakePicker" /><Button x:Name="SaveSettingsButton" Content="Сохранить и применить" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Свои адреса и исключения" Style="{StaticResource Heading}" /><ComboBox x:Name="UserListPicker" SelectedIndex="0" SelectionChanged="UserList_Changed"><ComboBoxItem Content="Домены для обхода" /><ComboBoxItem Content="Исключённые домены" /><ComboBoxItem Content="Исключённые IP и подсети" /><ComboBoxItem Content="Свои IP и подсети · для режима loaded" /></ComboBox><TextBox x:Name="UserListBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="150" FontFamily="Consolas" Margin="0,12" /><Button x:Name="SaveListButton" Content="Сохранить список" HorizontalAlignment="Left" Click="SaveList_Click" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Компоненты Flowseal" Style="{StaticResource Heading}" /><TextBlock x:Name="FlowsealVersionText" Text="Сведения о компонентах" FontSize="16" Margin="0,0,0,10" /><TextBlock Text="Новые профили, движок и стандартные списки поступают с проверенными обновлениями x2zapret. Ваши настройки и пользовательские списки сохраняются." Style="{StaticResource Muted}" Margin="0,0,0,16" /><Button Content="Изменения Flowseal" Click="FlowsealChanges_Click" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Обновления и обслуживание" Style="{StaticResource Heading}" /><WrapPanel><Button x:Name="UpdateIpSetButton" Content="Обновить IPSet" Click="UpdateIpSet_Click" Margin="0,0,10,10" /><Button x:Name="UpdateHostsButton" Content="Обновить hosts" Click="UpdateHosts_Click" Margin="0,0,10,10" /><Button x:Name="RemoveHostsButton" Content="Убрать записи x2zapret из hosts" Click="RemoveHosts_Click" Margin="0,0,10,10" /><Button Content="Открыть страницу релизов" Click="Releases_Click" Margin="0,0,10,10" /></WrapPanel><TextBlock Text="Обновления движка устанавливаются с новой сборкой приложения. Пользовательские списки хранятся отдельно." Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="ToolsPanel" Visibility="Collapsed">
            <WrapPanel Margin="0,0,0,16">
              <Button x:Name="PcToolButton" Content="Информация о ПК" Style="{StaticResource Primary}" Click="SelectPcTool_Click" Margin="0,0,10,0" />
              <Button x:Name="TimerToolButton" Content="Таймер выключения" Click="SelectTimerTool_Click" />
            </WrapPanel>
            <StackPanel x:Name="PcInfoPanel">
              <StackPanel.Resources><Style x:Key="PcMuted" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="LineHeight" Value="14" /></Style></StackPanel.Resources>
              <Border Style="{StaticResource Card}" Padding="14"><StackPanel>                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="ПРОЦЕССОР" Style="{StaticResource PcMuted}" FontSize="10" /><TextBlock x:Name="PcCpuText" Text="—" FontSize="28" FontFamily="Consolas" Margin="0,5" /><ProgressBar x:Name="PcCpuBar" Maximum="100" /><TextBlock Text="Общая загрузка CPU" Style="{StaticResource PcMuted}" FontSize="11" Margin="0,7,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="ПАМЯТЬ" Style="{StaticResource PcMuted}" FontSize="10" /><TextBlock x:Name="PcMemoryText" Text="—" FontSize="28" FontFamily="Consolas" Margin="0,5" /><ProgressBar x:Name="PcMemoryBar" Maximum="100" /><TextBlock x:Name="PcMemoryDetail" Text="Используется / всего" Style="{StaticResource PcMuted}" FontSize="11" Margin="0,7,0,0" /></StackPanel>
                  <StackPanel Grid.Column="4"><TextBlock Text="СЕТЬ · МиБ/с" Style="{StaticResource PcMuted}" FontSize="10" /><Viewbox Height="38" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,5"><TextBlock x:Name="PcNetworkText" Text="↓ —   ↑ —" FontFamily="Consolas" FontSize="22" /></Viewbox><TextBlock Text="Сумма активных адаптеров · каждые 2 с" Style="{StaticResource PcMuted}" FontSize="11" /></StackPanel>
                </Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Раздел" Style="{StaticResource PcMuted}" FontSize="12" Margin="0,0,0,7" /><ComboBox x:Name="PcCategoryPicker" SelectionChanged="PcCategory_Changed" AutomationProperties.Name="Раздел информации о ПК" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Поиск в разделе" Style="{StaticResource PcMuted}" FontSize="12" Margin="0,0,0,7" /><TextBox x:Name="PcSearchBox" MaxLength="256" TextChanged="SearchPc_Changed" AutomationProperties.Name="Поиск по устройству, параметру или значению" /></StackPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0"><Button x:Name="PcRefreshButton" FontSize="12" Padding="12,7" Content="Обновить" Click="RefreshPc_Click" Margin="0,0,8,6" /><Button x:Name="PcExportButton" FontSize="12" Padding="12,7" Content="Сохранить полный отчёт" Click="ExportPc_Click" Margin="0,0,8,6" /><Button x:Name="PcCancelButton" FontSize="12" Padding="12,7" Content="Отменить сбор" Click="CancelPc_Click" IsEnabled="False" Margin="0,0,8,6" /><Button x:Name="PcDriverButton" Content="Включить датчики CPU / платы / SPD" Click="InstallPawn_Click" Visibility="Collapsed" Margin="0,0,0,6" FontSize="12" Padding="12,7" ToolTip="Скачать проверенный подписанный драйвер PawnIO с официального GitHub и установить его. Дополнительная программа для мониторинга не нужна." /></WrapPanel>
                <CheckBox x:Name="PcPrivateCheck" FontSize="12" Content="Показывать личные данные и включать их в отчёт" Checked="FilterPc_Changed" Unchecked="FilterPc_Changed" Margin="0,0,0,10" />
                <TextBlock x:Name="PcStatusText" Text="Откройте раздел или нажмите «Обновить»." Style="{StaticResource PcMuted}" FontSize="12" Margin="0,0,0,12" />
                <DataGrid x:Name="PcRowsGrid" Height="350" RowHeight="34" ColumnHeaderHeight="34" FontSize="12" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Сведения о компьютере">
                  <DataGrid.Columns><DataGridTextColumn Header="Устройство" Binding="{Binding Device}" Width="1.1*" MinWidth="120" /><DataGridTextColumn Header="Параметр" Binding="{Binding Property}" Width="*" MinWidth="110" /><DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="1.5*" MinWidth="110" /><DataGridTextColumn x:Name="PcMinimumColumn" Header="Мин." Binding="{Binding Minimum}" Width="80" Visibility="Collapsed" /><DataGridTextColumn x:Name="PcMaximumColumn" Header="Макс." Binding="{Binding Maximum}" Width="80" Visibility="Collapsed" /></DataGrid.Columns>
                  <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Value}" /></Style></DataGrid.RowStyle>
                </DataGrid>
                <StackPanel x:Name="PcHardwareBar" Visibility="Collapsed" Margin="0,0,0,10">
                  <TextBlock x:Name="PcDriverStatus" Style="{StaticResource PcMuted}" FontSize="11" Margin="0,0,0,6" />
                </StackPanel>
                <TextBlock x:Name="PcWarningText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,14,0,0" />
                <TextBlock Text="Серийные номера, сетевые адреса и пути скрыты по умолчанию. Ctrl+C копирует выделенные строки. Встроенные датчики работают без отдельного приложения. Стресс-тестов нет." Style="{StaticResource PcMuted}" FontSize="11" Margin="0,12,0,0" />
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="ShutdownToolPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="28">
              <StackPanel>
                <TextBlock Text="02 / SHUTDOWN TIMER" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" />
                <TextBlock Text="Выключение по таймеру" Style="{StaticResource Heading}" />
                <TextBlock Text="Выберите, через сколько выключить компьютер. Таймер продолжит работать, даже если закрыть x2zapret." Style="{StaticResource Muted}" Margin="0,0,0,22" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="24" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Часы" Style="{StaticResource Muted}" Margin="0,0,0,7" /><TextBox x:Name="ShutdownHoursBox" Text="1" MaxLength="3" FontSize="24" FontFamily="Consolas" AutomationProperties.Name="Часы до выключения компьютера" /></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Минуты" Style="{StaticResource Muted}" Margin="0,0,0,7" /><TextBox x:Name="ShutdownMinutesBox" Text="0" MaxLength="2" FontSize="24" FontFamily="Consolas" AutomationProperties.Name="Минуты до выключения компьютера" /></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,16,0,0">
                      <Button Content="15 мин" Tag="15" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="30 мин" Tag="30" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="1 час" Tag="60" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,8,8" />
                      <Button Content="2 часа" Tag="120" FontSize="12" Click="ShutdownPreset_Click" Padding="10,7" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                  <Border Grid.Column="2" Background="#0A0A0A" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="18">
                    <StackPanel><TextBlock Text="ОСТАЛОСЬ" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                      <Viewbox Height="58" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" Margin="0,8,0,4"><TextBlock x:Name="ShutdownCountdown" Text="— : — : —" FontSize="40" FontFamily="Consolas" /></Viewbox>
                      <TextBlock x:Name="ShutdownStatus" Text="Таймер не запущен" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </Grid>
                <WrapPanel Margin="0,22,0,0">
                  <Button x:Name="StartShutdownTimerButton" Content="Запустить таймер" Style="{StaticResource Primary}" Click="StartShutdownTimer_Click" Margin="0,0,12,10" />
                  <Button x:Name="CancelShutdownTimerButton" Content="Отменить таймер" IsEnabled="False" Click="CancelShutdownTimer_Click" Margin="0,0,0,10" />
                </WrapPanel>
                <TextBlock x:Name="ShutdownTimerError" Foreground="#FFD4D8" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Как работает таймер" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Text="• От 1 минуты до 7 дней. Отменить можно до начала выключения.&#x0a;• Windows не будет принудительно закрывать программы. Несохранённые документы могут задержать выключение.&#x0a;• Компьютер должен быть включён, пользователь - оставаться в системе. Таймер не будит ПК и не срабатывает позже пропущенного времени после сна или перезагрузки." Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel></Border>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="LogsPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="События приложения" Style="{StaticResource Heading}" /><Button Content="Сохранить журнал" HorizontalAlignment="Right" Click="ExportLog_Click" Padding="14,8" /></Grid><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="490" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Margin="0,12,0,0" /></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer></Border>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><StackPanel><Grid><TextBlock x:Name="StatusText" Text="Подготовка приложения…" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="ProgressCounter" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" /></Grid><ProgressBar x:Name="OperationProgress" Margin="0,10,0,0" Visibility="Collapsed" /></StackPanel></Border>
    </Grid>
  </Grid>
  </Grid></Border>
</Window>
